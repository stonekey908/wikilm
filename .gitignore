.DS_Store
*.swp
*.swo
*~

# Database
*.db
*.db-wal
*.db-shm

# App
app/node_modules/
app/.next/
app/.env.local

# Backups — local-only by default. Opt in manually if you want offsite copies.
backups/

# External tooling metadata (CodeView analysis sidecars, etc.) — not part of
# WikiLM itself, lives here only because the tooling writes to cwd.
.codeview/

# Internal design-handoff docs — kept locally for reference, not for public.
design_handoff_wikilm_editorial/
design-handoff/

# Per-session handoff notes for Claude Code continuity — local only.
.claude/HANDOFF.md

# ─────────────────────────────────────────────────────────────────────
# User content — ignored by default so the shared repo is a clean install.
# The empty .gitkeep scaffolding stays in source control so every clone
# boots with the right directory shape.
/wiki/**/*
!/wiki/**/.gitkeep

/raw/*
!/raw/.gitkeep

/projects/**/*
!/projects/**/.gitkeep
